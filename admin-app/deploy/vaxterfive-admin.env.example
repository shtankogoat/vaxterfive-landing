# /etc/vaxterfive-admin.env   (chown root:root, chmod 600 — systemd читает его от root)
SECRET_KEY=СГЕНЕРИРУЙТЕ: python3 manage.py gen-secret
SITE_ROOT=/var/www/vaxterfive
ADMIN_DATA=/var/lib/vaxterfive-admin
# Секретный адрес админки. Сгенерируйте СВОЙ:  python3 -c "import secrets;print('/vf-'+secrets.token_hex(16)+'/')"
# Тот же префикс вписать в nginx-admin.conf.
ADMIN_PREFIX=/vf-ЗАМЕНИТЕ-НА-СВОЙ/
COOKIE_SECURE=1
BEHIND_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
# Ключ шифрования TOTP-секретов (необязательно; по умолчанию выводится из SECRET_KEY).
# Если задать отдельно — смена SECRET_KEY не сбросит 2FA. Сгенерировать: python3 manage.py gen-secret
TOTP_ENC_KEY=
# Уведомления о входах в Telegram (на сервере в РФ нужен прокси: socks5h://user:pass@host:port или http://...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_PROXY=
# Адрес сайта (для ссылки на файл заявки в примечании AmoCRM)
SITE_URL=https://vaxterfive.ru
# AmoCRM (заявки с сайта). Пусто — заявки сохраняются, статус «не настроено».
AMO_SUBDOMAIN=
AMO_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_RESPONSIBLE_USER_ID=
AMO_PROXY=
